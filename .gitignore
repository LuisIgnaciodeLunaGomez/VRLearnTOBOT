#configuración del archivo .gitignore para evitar la subida de archivos de Unity
#los archivos de UNITY se localizan en Control de versiones de Unity - Plastic SCM

# Archivos generados por Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Configuración personal
UserSettings/

# Archivos de Plastic SCM
.plastic/

# Ignorar configuraciones de Visual Studio
.vs/

#ignorar archivos pdf
.pdf/

#ignorar archivos que no sean pdf, tex o bib
project-docs/tex/*
!project-docs/tex/*.pdf
!project-docs/tex/*.tex
!project-docs/tex/*.bib

#ignorar el directorio release
.release/
.utmp/

