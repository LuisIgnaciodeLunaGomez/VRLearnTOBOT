#configuración del archivo .gitignore para evitar la subida de archivos de Unity
#los archivos de UNITY se localizan en Control de versiones de Unity - Plastic SCM

# Archivos generados por Unity
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Configuración personal
UserSettings/

# Archivos de Plastic SCM
.plastic/

# Ignorar configuraciones de Visual Studio
.vs/

#ignorar archivos pdf
.pdf/

#ignorar archivos que no sean pdf, tex o bib
project-docs/tex/*
!project-docs/tex/*.pdf
!project-docs/tex/*.tex
!project-docs/tex/*.bib

#ignorar el directorio release
.release/
.utmp/

project-app/ProjectSettings/ProjectSettings.asset
project-app/Assembly-CSharp.csproj
project-app/Assembly-CSharp.csproj
project-app/ProjectSettings/Packages/com.unity.muse.common/Settings.json
project-app/Assembly-CSharp.csproj
project-app/ProjectSettings/Packages/com.unity.muse.common/Settings.json
/project-app/__Assets/Settings
/project-app/__Assets/TextMesh Pro/Resources
/project-app/__Assets/TextMesh Pro
project-app/__Assets/App UI Settings.asset
project-app/__Assets/App UI Settings.asset.meta
project-app/ProjectSettings/EditorBuildSettings.asset
project-app/ProjectSettings/Packages/com.unity.muse.common/Settings.json
project-app/ProjectSettings/ShaderGraphSettings.asset
