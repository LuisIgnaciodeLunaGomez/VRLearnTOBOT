<?xml version="1.0" encoding="utf-8"?>
<toolbox style="Scratch">
	<!-- El atributo style es opcional  -->

	<!-- Categoría Movimiento -->
	<!-- 'Name' de Categories.xml para el atributo 'name' -->
	<!--  'Color' de Categories.xml para el atributo 'colour' -->
	<category name="MOTION" color="#4C97FF">
		<!-- Lista los 'type' de los bloques definidos en Movimiento.xml -->
		<block type="motion_movesteps"></block>
		<!-- <block type="motion_goto"></block> -->
		
		<!-- <block type="motion_turnright"></block> -->
		<!-- <block type="motion_turnleft"></block> -->
		
	</category>

	<!-- Categoría Apariencia -->
	<category name="LOOKS" color="#9966FF">
		
	</category>

	<!-- Categoría Sonido -->
	<category name="SOUND" color="#CF63CF">
	</category>

	<!-- Categoría Eventos -->
	<category name="EVENTS" color="#FFBF00">
		<block type="event_whenflagclicked"></block>
		
	</category>

	<!-- Categoría Control -->
	<category name="CONTROL" color="#FFAB19">

	</category>

	<!-- Categoría Sensores -->
	<category name="SENSING" color="#5CB1D6">
	</category>

	<!-- Categoría Operadores -->
	<category name="OPERATORS" color="#59C059">
		
	</category>

	<!-- Categorías Especiales -->

	<category name="VARIABLES" color="#FF8C1A" custom="VARIABLE"></category>
	<category name="MY_BLOCKS" color="#FF6680" custom="PROCEDURE"></category>
	
</toolbox>