  m_Name: 
  m_EditorClassIdentifier: 
  mainOptionsPanel: {fileID: 1909024989}
  challengeSelectionPanel: {fileID: 1253915072}
  challengeListContentContainer: {fileID: 632425554}
  challengeCardPrefab: {fileID: 4890254472947656590, guid: 1ef6e719fc7fc5a4485dad270cc3e4a5, type: 3}
  backFromChallengesButton: {fileID: 0}
  challengeDetailsPanel: {fileID: 1063331330}
  detailTitleText: {fileID: 1543948766}
  detailStepText: {fileID: 1005721683}
  detailVideoRawImage: {fileID: 1803620544}
  videoPlayer: {fileID: 1837422027}
  detailStartButton: {fileID: 1051158654}
  detailCloseButton: {fileID: 1137864251}
  availableChallenges:
  - id: challenge_01_movingblocks
    displayName: Moviendo y Eliminando Bloques
    description: "Aprende lo b\xE1sico: c\xF3mo arrastrar bloques desde la caja de
      herramientas, conectarlos y eliminarlos si cometes un error."
    videoPreviewClip: {fileID: 32900000, guid: b030e072e3d61874987a53d0d5b7a579, type: 3}
    targetSceneToLoad: UGUIScene
    thumbnailSpriteName: move_erase_blocks
  - id: challenge_02_driving
    displayName: Conduciendo su robot
    description: "\xA1Hagamos que el robot se mueva! Utiliza el bloque 'mover x pasos'
      para programar tu primera secuencia y ver al robot cobrar vida en el escenario
      3D."
    videoPreviewClip: {fileID: 32900000, guid: 08fe9ae942945f14b90035e4b0f42a49, type: 3}
    targetSceneToLoad: UGUIScene
    thumbnailSpriteName: conduciendo_su_robot
  - id: challenge_03_loops
    displayName: Usando Bucles
    description: "La eficiencia es clave. Aprende a usar el bloque 'repetir' para
      que tu robot dibuje un cuadrado sin tener que repetir el mismo c\xF3digo una
      y otra vez."
    videoPreviewClip: {fileID: 32900000, guid: 151ac1df5a01d4f42af7ff9539e1bf61, type: 3}
    targetSceneToLoad: UGUIScene
    thumbnailSpriteName: usando_bucles
  - id: challenge_04_cams
    displayName: "Usando las C\xE1maras"
    description: "Para una experiencia inmersiva es fundamental comprender el uso
      de las c\xE1maras para ver las acciones del robot. Crea un programa que mueva
      al robot X pasos y prueba las diferentes c\xE1maras para ver el movimiento
      del robot en diferentes perspectivas. "
    videoPreviewClip: {fileID: 32900000, guid: cfd90f85d5673e84388fcd6e0ef5aace, type: 3}
    targetSceneToLoad: UGUIScene
    thumbnailSpriteName: usando_camaras
  - id: challenge_05_collision
    displayName: Probando colisiones
    description: "En un entorno simulado la colsi\xF3n del robot con el l\xEDmite
      del tablero har\xE1 que este par\xE9. Prueb\xE1lo y ver\xE1s como se para al
      llegar al l\xEDmite aunque tu c\xF3digo fuera m\xE1s grande. Es el mismo caso
      que ocurrir\xEDa en un entorno real."
    videoPreviewClip: {fileID: 32900000, guid: 1f5d0c14e1328af48bf529b41989cca5, type: 3}
    targetSceneToLoad: UGUIScene
    thumbnailSpriteName: usando_camaras
